{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CalibrationFreezeManifest.v1",
  "title": "CalibrationFreezeManifest.v1",
  "type": "object",
  "x-approveHashBindings": true,
  "additionalProperties": false,
  "required": ["decision_id", "evidence_package_sha256", "validation_report_sha256", "approved_policy_version", "approved_thresholds", "decision", "decided_by", "decided_at", "independent_review_ack", "pillar_weights", "downside_component_weights", "anti_double_count_policy_version", "evidence_family_policy_scope", "evidence_family_policy_locator", "evidence_family_policy_canonicalization", "evidence_family_policy_sha256", "expiry", "evidence_package_coverage", "rating_disposition"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_package_sha256": {"$ref": "#/$defs/sha256"},
    "validation_report_sha256": {"$ref": "#/$defs/sha256"},
    "approved_policy_version": {"anyOf": [{"$ref": "#/$defs/semver"}, {"type": "null"}]},
    "approved_thresholds": {"anyOf": [{"$ref": "#/$defs/thresholds"}, {"type": "null"}]},
    "decision": {"enum": ["approve", "hold", "revise"]},
    "decided_by": {"const": "Wayne"},
    "decided_at": {"$ref": "#/$defs/aware_datetime"},
    "independent_review_ack": {"type": "string", "minLength": 1, "maxLength": 256},
    "pillar_weights": {"$ref": "#/$defs/pillar_weights"},
    "downside_component_weights": {"$ref": "#/$defs/downside_weights"},
    "anti_double_count_policy_version": {"$ref": "#/$defs/semver"},
    "evidence_family_policy_scope": {"const": "quality_and_downside"},
    "evidence_family_policy_locator": {"const": "AnalysisSnapshot.sections.candidate_policy.anti_double_count_policy.evidence_family_ownership"},
    "evidence_family_policy_canonicalization": {"const": "RFC8785_JCS"},
    "evidence_family_policy_sha256": {"$ref": "#/$defs/sha256"},
    "expiry": {"anyOf": [{"$ref": "#/$defs/aware_datetime"}, {"type": "null"}]},
    "evidence_package_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "approve"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "approved_policy_version": {"$ref": "#/$defs/semver"},
          "approved_thresholds": {"$ref": "#/$defs/thresholds"},
          "independent_review_ack": {"type": "string", "pattern": "^EVIDENCE:PASS:[0-9a-f]{64};SEMANTICS:PASS:[0-9a-f]{64};WAYNE:APPROVE:[0-9a-f]{64}$"}
        }
      },
      "else": {
        "properties": {
          "approved_policy_version": {"type": "null"},
          "approved_thresholds": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "aware_datetime": {"type": "string", "format": "date-time", "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "thresholds": {
      "type": "object", "additionalProperties": false, "required": ["quality_bands", "upside_stars", "downside_faces", "bomb_materiality"],
      "properties": {
        "quality_bands": {"type": "array", "minItems": 1, "maxItems": 9, "x-strictlyAscending": true, "items": {"type": "number", "minimum": 0, "maximum": 100}},
        "upside_stars": {"type": "array", "minItems": 4, "maxItems": 4, "x-strictlyAscending": true, "items": {"type": "number", "minimum": -1, "maximum": 10}},
        "downside_faces": {"type": "array", "minItems": 4, "maxItems": 4, "x-strictlyAscending": true, "items": {"type": "number", "minimum": 0, "maximum": 100}},
        "bomb_materiality": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "pillar_weights": {
      "type": "object", "additionalProperties": false, "required": ["audit_reliability", "earnings_capital_efficiency", "cash_balance_allocation", "business_moat", "governance", "people_adaptability", "sum"],
      "properties": {"audit_reliability": {"const": 0.1}, "earnings_capital_efficiency": {"const": 0.25}, "cash_balance_allocation": {"const": 0.25}, "business_moat": {"const": 0.25}, "governance": {"const": 0.05}, "people_adaptability": {"const": 0.1}, "sum": {"const": 1}}
    },
    "downside_weights": {
      "type": "object", "additionalProperties": false, "x-sumEquals": {"fields": ["maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability"], "value": 1}, "required": ["maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability", "sum"],
      "properties": {"maximum_drawdown_vulnerability": {"type": "number", "minimum": 0.25, "maximum": 0.4}, "permanent_capital_loss_vulnerability": {"type": "number", "minimum": 0.25, "maximum": 0.4}, "material_adverse_event_vulnerability": {"type": "number", "minimum": 0.25, "maximum": 0.4}, "sum": {"const": 1}}
    }
  }
}
