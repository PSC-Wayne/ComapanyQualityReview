{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuditGateDecision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_state",
    "opinion_type",
    "going_concern",
    "restatement",
    "confirmed_fraud",
    "key_audit_matter_first_occurrence",
    "emphasis_matter_first_occurrence",
    "auditor_change",
    "cap_value",
    "upside_star_cap",
    "floor_value",
    "reasons",
    "evidence_ids",
    "available_at",
    "coverage",
    "no_rating_reason",
    "rating_disposition",
    "schema_version",
    "source_version",
    "formula_version",
    "model_version"
  ],
  "properties": {
    "gate_state": {
      "enum": ["clear", "cap", "no_rating", "blocked"]
    },
    "opinion_type": {
      "type": ["string", "null"],
      "enum": ["unmodified", "qualified", "adverse", "disclaimer", null]
    },
    "going_concern": {"type": ["boolean", "null"]},
    "restatement": {"type": ["boolean", "null"]},
    "confirmed_fraud": {"type": ["boolean", "null"]},
    "key_audit_matter_first_occurrence": {"type": ["boolean", "null"]},
    "emphasis_matter_first_occurrence": {"type": ["boolean", "null"]},
    "auditor_change": {"type": ["boolean", "null"]},
    "cap_value": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "upside_star_cap": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "floor_value": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "available_at": {"type": "string", "format": "date-time"},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "no_rating_reason": {
      "type": ["string", "null"],
      "enum": [
        "formal_disclaimer",
        "formal_adverse",
        "missing_mandatory_evidence",
        "authority_conflict",
        null
      ]
    },
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"},
    "schema_version": {"const": "AuditGateDecision.v1"},
    "source_version": {"type": "string", "minLength": 1},
    "formula_version": {"const": "audit-hard-gate.v1"},
    "model_version": {"type": "string", "minLength": 1}
  }
}
