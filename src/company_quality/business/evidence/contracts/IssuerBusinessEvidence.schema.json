{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IssuerBusinessEvidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuer_id", "observations", "source_records", "evidence_family_ids",
    "counter_evidence_ids", "ai_execution_ids", "available_at", "coverage",
    "confidence", "generation_id", "producer_candidate_sha", "status", "reason",
    "publication_status", "rating_disposition", "schema_version", "source_version",
    "formula_version", "model_version"
  ],
  "$defs": {
    "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "tier": {"enum": ["official", "issuer_primary", "trusted_secondary"]},
    "category": {"enum": [
      "revenue_driver", "customer_concentration", "supplier_concentration",
      "geography_concentration", "switching_cost", "network_effect",
      "cost_advantage", "intangible_assets", "efficient_scale", "competition"
    ]},
    "ids": {
      "type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  },
  "properties": {
    "issuer_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "observations": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "evidence_id", "source_id", "source_tier", "claim_key", "category",
          "name", "statement", "direction", "numeric_value", "period_end",
          "available_at", "extraction_method", "ai_execution_id"
        ],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source_tier": {"$ref": "#/$defs/tier"},
          "claim_key": {"type": "string", "minLength": 1, "maxLength": 128},
          "category": {"$ref": "#/$defs/category"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "statement": {"type": "string", "minLength": 1, "maxLength": 512},
          "direction": {"enum": ["support", "counter", "context"]},
          "numeric_value": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "period_end": {"type": "string", "format": "date"},
          "available_at": {"$ref": "#/$defs/time"},
          "extraction_method": {"enum": ["deterministic", "llm"]},
          "ai_execution_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
        }
      }
    },
    "source_records": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_tier", "url", "content_sha256", "available_at", "retrieved_at", "used"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source_tier": {"$ref": "#/$defs/tier"},
          "url": {"type": "string", "format": "uri"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "available_at": {"$ref": "#/$defs/time"},
          "retrieved_at": {"$ref": "#/$defs/time"},
          "used": {"type": "boolean"}
        }
      }
    },
    "evidence_family_ids": {"$ref": "#/$defs/ids"},
    "counter_evidence_ids": {"$ref": "#/$defs/ids"},
    "ai_execution_ids": {"$ref": "#/$defs/ids"},
    "available_at": {"$ref": "#/$defs/time"},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "available"},
    "reason": {"type": "null"},
    "publication_status": {"const": "NON_PUBLISHABLE_CANDIDATE"},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"},
    "schema_version": {"const": "IssuerBusinessEvidence.v1"},
    "source_version": {"const": "T06+issuer-primary+trusted-secondary.v1"},
    "formula_version": {"const": "official-first-claim-admission.v1"},
    "model_version": {"const": "issuer-business-evidence-1.0.0"}
  }
}
