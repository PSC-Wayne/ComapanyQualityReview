{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DownsideStressDiagnostic.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["horizon_months", "constructs", "risk_items", "stress_pack", "bomb_candidate", "evidence_ids", "metric_lineage", "coverage", "available_at", "publication_status", "rating_disposition", "schema_version", "source_version", "formula_version", "model_version"],
  "$defs": {
    "decimal": {"type": "number", "minimum": -1000000000000000000, "maximum": 1000000000000000000},
    "id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lineageIds": {"type": "array", "minItems": 0, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "construct": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_value", "normalised_score", "evidence_ids"],
      "properties": {
        "raw_value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]},
        "normalised_score": {"type": "null"},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "stress": {
      "type": "object", "additionalProperties": false,
      "required": ["assumption_ids", "equity_value_change_pct", "liquidity_state"],
      "properties": {
        "assumption_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "equity_value_change_pct": {"$ref": "#/$defs/decimal"},
        "liquidity_state": {"enum": ["adequate", "tight", "insolvent"]}
      }
    }
  },
  "properties": {
    "horizon_months": {"const": 12},
    "constructs": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability"],
      "properties": {
        "maximum_drawdown_vulnerability": {"$ref": "#/$defs/construct"},
        "permanent_capital_loss_vulnerability": {"$ref": "#/$defs/construct"},
        "material_adverse_event_vulnerability": {"$ref": "#/$defs/construct"}
      }
    },
    "risk_items": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cause", "exposure", "transmission_path", "buffer", "indicator", "severity", "trigger", "threshold", "evidence_id"],
        "properties": {
          "cause": {"type": "string", "minLength": 1, "maxLength": 256},
          "exposure": {"type": "string", "minLength": 1, "maxLength": 256},
          "transmission_path": {"type": "string", "minLength": 1, "maxLength": 512},
          "buffer": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
          "indicator": {"type": "string", "minLength": 1, "maxLength": 256},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "trigger": {"type": "string", "minLength": 1, "maxLength": 256},
          "threshold": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]},
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    },
    "stress_pack": {
      "type": "object", "additionalProperties": false,
      "required": ["bear", "base", "bull"],
      "properties": {"bear": {"$ref": "#/$defs/stress"}, "base": {"$ref": "#/$defs/stress"}, "bull": {"$ref": "#/$defs/stress"}}
    },
    "bomb_candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["event_id", "event_type", "authoritative", "material", "current_relevance", "authority_source_id", "effective_at", "expires_at", "evidence_ids"],
          "properties": {
            "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "event_type": {"enum": ["formal_adverse_opinion", "formal_disclaimer", "confirmed_fraud", "default", "insolvency", "major_regulatory_action", "other_governed"]},
            "authoritative": {"type": "boolean"}, "material": {"type": "boolean"}, "current_relevance": {"type": "boolean"},
            "authority_source_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "effective_at": {"$ref": "#/$defs/time"},
            "expires_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
            "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
          }
        }
      ]
    },
    "evidence_ids": {"$ref": "#/$defs/ids"},
    "metric_lineage": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/lineageIds"}},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "available_at": {"$ref": "#/$defs/time"},
    "publication_status": {"const": "NON_PUBLISHABLE_CANDIDATE"},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"},
    "schema_version": {"const": "DownsideStressDiagnostic.v1"},
    "source_version": {"const": "DownsideAssumptionBundle.v1+CanonicalFinancialFacts.v1+AuditGateDecision.v1+HighRiskNoteRegister.v1+CashBalanceAllocationCandidate.v1+PeerOutlookEvidence.v1+BusinessMoatCandidate.v1+GovernancePeopleCandidate.v1"},
    "formula_version": {"const": "governed-downside-diagnostic.v1"},
    "model_version": {"const": "normalisation-pending-t23"}
  }
}
