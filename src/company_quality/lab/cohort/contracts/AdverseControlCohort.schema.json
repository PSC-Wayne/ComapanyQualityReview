{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdverseControlCohort.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["market", "issuer_ids", "control_ids", "members", "event_taxonomy", "delisting_states", "censoring_rules", "cohort_asof", "window_start_inclusive", "window_end_exclusive", "lookback_calendar_years", "window_boundary_policy", "universe_policy", "delisted_included", "eligibility_version", "evidence_ids", "failure_reasons", "input_producer_shas", "cohort_coverage", "available_at", "generation_id", "producer_candidate_sha", "rating_disposition", "schema_version", "source_version", "formula_version", "model_version"],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "date": {"type": "string", "format": "date"},
    "instant": {"type": "string", "format": "date-time"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eventClass": {"enum": ["delisting", "default", "fraud", "restatement", "drawdown", "other_adverse"]},
    "state": {"enum": ["confirmed", "not_confirmed", "unknown"]},
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "security_code", "company_name", "market", "listed_on", "delisted_on", "disposition", "event_codes", "official_reasons", "evidence_ids"],
      "properties": {
        "issuer_id": {"$ref": "#/$defs/id"},
        "security_code": {"$ref": "#/$defs/id"},
        "company_name": {"$ref": "#/$defs/id"},
        "market": {"enum": ["TWSE", "TPEx"]},
        "listed_on": {"$ref": "#/$defs/date"},
        "delisted_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "disposition": {"enum": ["adverse", "control", "right_censored"]},
        "event_codes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "official_reasons": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "properties": {
    "market": {"enum": ["TWSE", "TPEx"]},
    "issuer_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "control_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "members": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/member"}},
    "event_taxonomy": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["event_code", "event_class", "authoritative_source_type"], "properties": {"event_code": {"type": "string", "minLength": 1, "maxLength": 64}, "event_class": {"$ref": "#/$defs/eventClass"}, "authoritative_source_type": {"type": "string", "minLength": 1, "maxLength": 64}}}},
    "delisting_states": {"type": "object", "additionalProperties": false, "required": ["forced_redemption", "maturity", "bankruptcy", "other_delisting"], "properties": {"forced_redemption": {"$ref": "#/$defs/state"}, "maturity": {"$ref": "#/$defs/state"}, "bankruptcy": {"$ref": "#/$defs/state"}, "other_delisting": {"$ref": "#/$defs/state"}}},
    "censoring_rules": {"type": "object", "additionalProperties": false, "required": ["right_censor_at", "min_followup_days", "suspension_policy", "missing_price_policy"], "properties": {"right_censor_at": {"$ref": "#/$defs/instant"}, "min_followup_days": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "suspension_policy": {"const": "right_censor_until_official_resume_or_delisting"}, "missing_price_policy": {"enum": ["confirmed_delisting_zero_contribution", "block_unconfirmed"]}}},
    "cohort_asof": {"$ref": "#/$defs/instant"},
    "window_start_inclusive": {"$ref": "#/$defs/date"},
    "window_end_exclusive": {"$ref": "#/$defs/date"},
    "lookback_calendar_years": {"const": 5},
    "window_boundary_policy": {"const": "asia_taipei_calendar_year_half_open_v1"},
    "universe_policy": {"const": "all_securities_listed_at_any_instant_during_window"},
    "delisted_included": {"const": true},
    "eligibility_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "failure_reasons": {"type": "object", "maxProperties": 10000, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}},
    "input_producer_shas": {"type": "object", "additionalProperties": false, "required": ["T03", "T04", "T06"], "properties": {"T03": {"$ref": "#/$defs/sha"}, "T04": {"$ref": "#/$defs/sha"}, "T06": {"$ref": "#/$defs/sha"}}},
    "cohort_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "available_at": {"$ref": "#/$defs/instant"},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer_candidate_sha": {"$ref": "#/$defs/sha"},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"},
    "schema_version": {"const": "AdverseControlCohort.v1"},
    "source_version": {"const": "AdmittedFactSet.v1+OfficialFinancialArtifacts.v1+AuditFilingInventory.v1+OfficialExchangeUniverse.v1"},
    "formula_version": {"const": "single-market-five-calendar-year-half-open.v1"},
    "model_version": {"const": "no-calibration-natural-controls.v1"}
  }
}
