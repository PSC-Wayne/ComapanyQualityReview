{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OutcomeLabelSet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["issuer_id", "decision_time", "wealth_series_ref", "adjusted_wealth_series", "drawdown_episodes", "adverse_labels", "horizon_months", "censoring_state", "label_version", "label_coverage", "sensitivity_outcomes", "adjustment_evidence_ids", "failure_reasons", "input_producer_shas", "available_at", "generation_id", "producer_candidate_sha", "rating_disposition", "schema_version", "source_version", "formula_version", "model_version"],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instant": {"type": "string", "format": "date-time"},
    "date": {"type": "string", "format": "date"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "label": {"enum": ["drawdown_over_50", "forced_delisting", "default", "fraud", "restatement", "other_material_adverse"]},
    "censor": {"enum": ["fully_observed", "right_censored", "blocked_missing_authority"]},
    "failures": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}},
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_date", "trough_date", "recovery_date", "maximum_drawdown_pct", "duration_days", "recovered"],
      "properties": {
        "peak_date": {"$ref": "#/$defs/date"},
        "trough_date": {"$ref": "#/$defs/date"},
        "recovery_date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "maximum_drawdown_pct": {"type": "number", "minimum": -100, "maximum": 0},
        "duration_days": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "recovered": {"type": "boolean"}
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon_months", "drawdown_episodes", "adverse_labels", "censoring_state", "label_version", "label_coverage", "failure_reasons"],
      "properties": {
        "horizon_months": {"enum": [24, 36]},
        "drawdown_episodes": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/episode"}},
        "adverse_labels": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/label"}},
        "censoring_state": {"$ref": "#/$defs/censor"},
        "label_version": {"$ref": "#/$defs/semver"},
        "label_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "failure_reasons": {"$ref": "#/$defs/failures"}
      }
    }
  },
  "properties": {
    "issuer_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "decision_time": {"$ref": "#/$defs/instant"},
    "wealth_series_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "adjusted_wealth_series": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["effective_on", "adjusted_wealth_index"], "properties": {"effective_on": {"$ref": "#/$defs/date"}, "adjusted_wealth_index": {"type": "number", "exclusiveMinimum": 0}}}},
    "drawdown_episodes": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/episode"}},
    "adverse_labels": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/label"}},
    "horizon_months": {"const": 12},
    "censoring_state": {"$ref": "#/$defs/censor"},
    "label_version": {"$ref": "#/$defs/semver"},
    "label_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "sensitivity_outcomes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/horizon"}, {"properties": {"horizon_months": {"const": 24}}}]},
        {"allOf": [{"$ref": "#/$defs/horizon"}, {"properties": {"horizon_months": {"const": 36}}}]}
      ],
      "items": false
    },
    "adjustment_evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "failure_reasons": {"$ref": "#/$defs/failures"},
    "input_producer_shas": {"type": "object", "additionalProperties": false, "required": ["T20", "PITWealthInput"], "properties": {"T20": {"$ref": "#/$defs/sha"}, "PITWealthInput": {"$ref": "#/$defs/sha"}}},
    "available_at": {"$ref": "#/$defs/instant"},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer_candidate_sha": {"$ref": "#/$defs/sha"},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"},
    "schema_version": {"const": "OutcomeLabelSet.v1"},
    "source_version": {"const": "AdverseControlCohort.v1+PITWealthInput.v1"},
    "formula_version": {"const": "unadjusted-close-action-cash-total-return.v1"},
    "model_version": {"const": "deterministic-outcome-labels-no-calibration.v1"}
  }
}
