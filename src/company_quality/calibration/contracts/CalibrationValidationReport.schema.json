{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CalibrationValidationReport.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "train_windows", "holdout_windows", "purge_days", "embargo_days", "metrics", "calibration_curves", "champion_verdict", "challenger_results", "threshold_candidates", "leakage_checks", "error_analysis", "stability_checks", "validation_coverage", "failure_reasons", "input_producer_shas", "generation_id", "producer_candidate_sha", "publishable", "rating_disposition", "schema_version", "source_version", "formula_version", "model_version"],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "nullableProbability": {"oneOf": [{"$ref": "#/$defs/probability"}, {"type": "null"}]},
    "window": {"type": "object", "additionalProperties": false, "required": ["start", "end", "issuer_count"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "issuer_count": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}
  },
  "properties": {
    "policy_version": {"$ref": "#/$defs/semver"},
    "train_windows": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/window"}},
    "holdout_windows": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/window"}},
    "purge_days": {"const": 365},
    "embargo_days": {"const": 30},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["auc", "brier", "calibration_error", "precision_at_top"], "properties": {"auc": {"$ref": "#/$defs/nullableProbability"}, "brier": {"$ref": "#/$defs/nullableProbability"}, "calibration_error": {"$ref": "#/$defs/nullableProbability"}, "precision_at_top": {"$ref": "#/$defs/nullableProbability"}}},
    "calibration_curves": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["bucket", "predicted", "observed", "count"], "properties": {"bucket": {"type": "string", "minLength": 1, "maxLength": 32}, "predicted": {"$ref": "#/$defs/probability"}, "observed": {"$ref": "#/$defs/probability"}, "count": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}},
    "champion_verdict": {"enum": ["pass", "fail", "blocked"]},
    "challenger_results": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["challenger_id", "metrics_hash", "verdict"], "properties": {"challenger_id": {"type": "string", "minLength": 1, "maxLength": 128}, "metrics_hash": {"$ref": "#/$defs/sha"}, "verdict": {"enum": ["better", "worse", "inconclusive"]}}}},
    "threshold_candidates": {"type": "object", "additionalProperties": false, "required": ["quality_bands", "upside_stars", "downside_faces", "bomb_materiality"], "properties": {"quality_bands": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "number", "minimum": 0, "maximum": 100}}, "upside_stars": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 10}}, "downside_faces": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 100}}, "bomb_materiality": {"const": 1}}},
    "leakage_checks": {"type": "object", "additionalProperties": false, "required": ["pit_join_pass", "purge_pass", "embargo_pass", "survivorship_pass", "same_generation_pass"], "properties": {"pit_join_pass": {"type": "boolean"}, "purge_pass": {"type": "boolean"}, "embargo_pass": {"type": "boolean"}, "survivorship_pass": {"type": "boolean"}, "same_generation_pass": {"type": "boolean"}}},
    "error_analysis": {"type": "object", "additionalProperties": false, "required": ["false_positives", "false_negatives", "false_signal_rate", "mean_adverse_lead_days"], "properties": {"false_positives": {"type": "integer", "minimum": 0}, "false_negatives": {"type": "integer", "minimum": 0}, "false_signal_rate": {"$ref": "#/$defs/nullableProbability"}, "mean_adverse_lead_days": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}}},
    "stability_checks": {"type": "object", "additionalProperties": false, "required": ["calibration_monotonic", "stress_auc", "stress_period_count"], "properties": {"calibration_monotonic": {"type": "boolean"}, "stress_auc": {"$ref": "#/$defs/nullableProbability"}, "stress_period_count": {"type": "integer", "minimum": 0}}},
    "validation_coverage": {"$ref": "#/$defs/probability"},
    "failure_reasons": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}},
    "input_producer_shas": {"type": "object", "additionalProperties": false, "required": ["T09", "T10", "T13", "T14", "T16", "T17", "T18", "T19", "T21"], "properties": {"T09": {"$ref": "#/$defs/sha"}, "T10": {"$ref": "#/$defs/sha"}, "T13": {"$ref": "#/$defs/sha"}, "T14": {"$ref": "#/$defs/sha"}, "T16": {"$ref": "#/$defs/sha"}, "T17": {"$ref": "#/$defs/sha"}, "T18": {"$ref": "#/$defs/sha"}, "T19": {"$ref": "#/$defs/sha"}, "T21": {"$ref": "#/$defs/sha"}}},
    "generation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer_candidate_sha": {"$ref": "#/$defs/sha"},
    "publishable": {"const": false},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"},
    "schema_version": {"const": "CalibrationValidationReport.v1"},
    "source_version": {"const": "T09+T10+T13+T14+T16+T17+T18+CandidatePolicyBundle.v1+OutcomeLabelSet.v1"},
    "formula_version": {"const": "winsor-family-rank-expanding-isotonic.v1"},
    "model_version": {"const": "train-only-pava-adverse-risk.v1"}
  }
}
