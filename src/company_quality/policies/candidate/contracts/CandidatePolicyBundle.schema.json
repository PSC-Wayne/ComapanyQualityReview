{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CandidatePolicyBundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["pillar_weights", "quality_policy", "upside_bucket_policy", "downside_bucket_policy", "anti_double_count_policy", "bomb_policy", "champion_id", "challenger_ids", "policy_version", "publishable", "policy_coverage", "failure_reasons", "input_producer_shas", "available_at", "generation_id", "producer_candidate_sha", "rating_disposition", "schema_version", "source_version", "formula_version", "model_version"],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "scoredComponent": {"enum": ["audit_reliability", "earnings_capital_efficiency", "cash_balance_allocation", "business_moat", "governance", "people_adaptability", "maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability"]},
    "component": {"enum": ["audit_reliability", "earnings_capital_efficiency", "cash_balance_allocation", "business_moat", "governance", "people_adaptability", "maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability", "hard_gate_only"]},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_family_id", "primary_component", "excluded_from", "disposition", "policy_rule_id", "evidence_ids"],
      "properties": {
        "evidence_family_id": {"$ref": "#/$defs/id"},
        "primary_component": {"$ref": "#/$defs/component"},
        "excluded_from": {"type": "array", "minItems": 0, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/scoredComponent"}},
        "disposition": {"enum": ["single_owner", "excluded_hard_gate", "excluded_duplicate"]},
        "policy_rule_id": {"$ref": "#/$defs/id"},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {"if": {"properties": {"primary_component": {"const": "hard_gate_only"}}, "required": ["primary_component"]}, "then": {"properties": {"disposition": {"const": "excluded_hard_gate"}, "excluded_from": {"minItems": 1}}}, "else": {"if": {"properties": {"excluded_from": {"maxItems": 0}}, "required": ["excluded_from"]}, "then": {"properties": {"disposition": {"const": "single_owner"}}}, "else": {"properties": {"disposition": {"const": "excluded_duplicate"}}}}},
        {"if": {"properties": {"primary_component": {"const": "audit_reliability"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "audit_reliability"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "earnings_capital_efficiency"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "earnings_capital_efficiency"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "cash_balance_allocation"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "cash_balance_allocation"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "business_moat"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "business_moat"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "governance"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "governance"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "people_adaptability"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "people_adaptability"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "maximum_drawdown_vulnerability"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "maximum_drawdown_vulnerability"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "permanent_capital_loss_vulnerability"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "permanent_capital_loss_vulnerability"}}}}}},
        {"if": {"properties": {"primary_component": {"const": "material_adverse_event_vulnerability"}}}, "then": {"properties": {"excluded_from": {"not": {"contains": {"const": "material_adverse_event_vulnerability"}}}}}}
      ]
    }
  },
  "properties": {
    "pillar_weights": {
      "type": "object", "additionalProperties": false,
      "required": ["audit_reliability", "earnings_capital_efficiency", "cash_balance_allocation", "business_moat", "governance", "people_adaptability", "sum"],
      "properties": {"audit_reliability": {"const": 0.10}, "earnings_capital_efficiency": {"const": 0.25}, "cash_balance_allocation": {"const": 0.25}, "business_moat": {"const": 0.25}, "governance": {"const": 0.05}, "people_adaptability": {"const": 0.10}, "sum": {"const": 1}}
    },
    "quality_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["normalisation", "winsor_lower_quantile", "winsor_upper_quantile", "cohort_locator", "minimum_cohort_size", "tie_method", "insufficient_cohort_disposition", "bands"],
      "properties": {
        "normalisation": {"const": "winsor_rank"}, "winsor_lower_quantile": {"const": 0.025}, "winsor_upper_quantile": {"const": 0.975},
        "cohort_locator": {"const": "PeerOutlookEvidence.peer_ids+issuer_id"}, "minimum_cohort_size": {"const": 5}, "tie_method": {"const": "average_percentile_rank"}, "insufficient_cohort_disposition": {"const": "NULL_BLOCKED_NO_FALLBACK"},
        "bands": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["lower", "upper", "label"], "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 100}, "upper": {"type": "number", "minimum": 0, "maximum": 100}, "label": {"type": "string", "minLength": 1, "maxLength": 32}}}}
      }
    },
    "upside_bucket_policy": {"type": "object", "additionalProperties": false, "required": ["horizon_months", "sensitivity_horizons_months", "return_unit", "thresholds", "audit_gate_contract"], "properties": {"horizon_months": {"const": 12}, "sensitivity_horizons_months": {"const": [24, 36]}, "return_unit": {"const": "decimal_return"}, "thresholds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 10}}, "audit_gate_contract": {"const": "AuditGateDecision.v1"}}},
    "downside_bucket_policy": {"type": "object", "additionalProperties": false, "required": ["horizon_months", "component_weights", "composite_thresholds", "construct_names"], "properties": {"horizon_months": {"const": 12}, "component_weights": {"type": "object", "additionalProperties": false, "required": ["maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability", "sum"], "properties": {"maximum_drawdown_vulnerability": {"const": 0.30}, "permanent_capital_loss_vulnerability": {"const": 0.40}, "material_adverse_event_vulnerability": {"const": 0.30}, "sum": {"const": 1}}}, "composite_thresholds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 100}}, "construct_names": {"const": ["maximum_drawdown_vulnerability", "permanent_capital_loss_vulnerability", "material_adverse_event_vulnerability"]}}},
    "anti_double_count_policy": {"type": "object", "additionalProperties": false, "required": ["version", "evidence_family_policy_locator", "evidence_family_policy_canonicalization", "evidence_family_policy_sha256", "evidence_family_ownership"], "properties": {"version": {"const": "1.0.0"}, "evidence_family_policy_locator": {"const": "AnalysisSnapshot.sections.candidate_policy.anti_double_count_policy.evidence_family_ownership"}, "evidence_family_policy_canonicalization": {"const": "RFC8785_JCS"}, "evidence_family_policy_sha256": {"$ref": "#/$defs/sha"}, "evidence_family_ownership": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/ownership"}}}},
    "bomb_policy": {"type": "object", "additionalProperties": false, "required": ["allowed_event_types", "requires_authoritative", "requires_material", "requires_current_relevance"], "properties": {"allowed_event_types": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["formal_adverse_opinion", "formal_disclaimer", "confirmed_fraud", "default", "insolvency", "major_regulatory_action", "other_governed"]}}, "requires_authoritative": {"const": true}, "requires_material": {"const": true}, "requires_current_relevance": {"const": true}}},
    "champion_id": {"$ref": "#/$defs/id"}, "challenger_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 0, "maxLength": 4096}}, "policy_version": {"$ref": "#/$defs/semver"}, "publishable": {"const": false}, "policy_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "failure_reasons": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 512}},
    "input_producer_shas": {"type": "object", "additionalProperties": false, "required": ["T07", "T09", "T10", "T12", "T13", "T14", "T16", "T17", "T18"], "properties": {"T07": {"$ref": "#/$defs/sha"}, "T09": {"$ref": "#/$defs/sha"}, "T10": {"$ref": "#/$defs/sha"}, "T12": {"$ref": "#/$defs/sha"}, "T13": {"$ref": "#/$defs/sha"}, "T14": {"$ref": "#/$defs/sha"}, "T16": {"$ref": "#/$defs/sha"}, "T17": {"$ref": "#/$defs/sha"}, "T18": {"$ref": "#/$defs/sha"}}},
    "available_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "generation_id": {"$ref": "#/$defs/id"}, "producer_candidate_sha": {"$ref": "#/$defs/sha"},
    "rating_disposition": {"const": "NO_RATING_NOT_APPLICABLE"}, "schema_version": {"const": "CandidatePolicyBundle.v1"},
    "source_version": {"const": "AuditGateDecision.v1+EarningsCapitalEfficiencyCandidate.v1+CashBalanceAllocationCandidate.v1+PeerOutlookEvidence.v1+BusinessMoatCandidate.v1+GovernancePeopleCandidate.v1+Pillar1AuditReliabilityCandidate.v1+ValuationUpsideDiagnostic.v1+DownsideStressDiagnostic.v1"},
    "formula_version": {"const": "candidate-policy-owned-families-jcs.v1"}, "model_version": {"const": "winsor-rank-peer-cohort-v1"}
  }
}
